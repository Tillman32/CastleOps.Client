# CastleOps Client Configuration
# Copy this file to config.yaml and customize for your environment

# Server connection settings
server:
  # API server URL
  url: "https://api.castleops.com"

  # Verify TLS certificates (set to false only for testing with self-signed certs)
  tls_verify: true

  # HTTP request timeout
  timeout: 30s

# Client identification (populated automatically on first registration)
client:
  # Unique client identifier (generated on registration)
  id: ""

  # Authentication token (obtained from server during registration)
  token: ""

# Heartbeat configuration
heartbeat:
  # Interval between heartbeat transmissions to server
  interval: 30s

  # Number of retry attempts before marking server as unreachable
  retry_attempts: 3

# Metrics collection configuration
metrics:
  # Interval between metric collection cycles
  collection_interval: 60s

  # Number of metrics to batch before sending to server
  batch_size: 100

  # Number of days to retain metrics locally before purging
  retention_days: 7

# Cache configuration
cache:
  # Cache backend type: "sqlite" (persistent) or "memory" (volatile)
  type: "sqlite"

  # Path to cache database (SQLite only)
  # Platform-specific defaults:
  #   macOS:   ~/Library/Application Support/CastleOps/data.db
  #   Windows: %LOCALAPPDATA%\CastleOps\data.db
  #   Linux:   /var/lib/castleops/data.db
  path: ""  # Leave empty to use platform default

# Logging configuration
logging:
  # Log level: trace, debug, info, warn, error, fatal, panic
  level: "info"

  # Log file path (empty means stdout only)
  # Platform-specific defaults:
  #   macOS:   ~/Library/Logs/CastleOps/client.log
  #   Windows: %LOCALAPPDATA%\CastleOps\Logs\client.log
  #   Linux:   /var/log/castleops/client.log
  path: ""  # Leave empty to use platform default

  # Log format: "json" (machine-readable) or "console" (human-readable)
  format: "json"

# Package manager configuration
package_managers:
  # Preferred package manager: "auto" (detect), "chocolatey", "homebrew"
  # "auto" will automatically detect the appropriate package manager for the platform
  preferred: "auto"

# Performance tuning (advanced)
# Uncomment and adjust these settings only if you need to tune performance

# performance:
#   # Maximum number of concurrent metric collectors
#   max_collectors: 4
#
#   # Size of the API request queue (for offline buffering)
#   request_queue_size: 1000
#
#   # Enable HTTP/2 for API communication
#   http2_enabled: true
#
#   # Connection pool settings
#   max_idle_conns: 10
#   max_conns_per_host: 5
#   idle_conn_timeout: 90s
